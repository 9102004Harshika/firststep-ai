NODE_ENV=development
PORT=5050

# MongoDB Atlas — database name firststep_ai (do not use local inkstall Compass)
MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER/?retryWrites=true&w=majority
MONGODB_DB_NAME=firststep_ai

ADMIN_API_KEY=change-me-to-a-long-random-secret
CORS_ORIGIN=http://localhost:5173

LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_FALLBACK_PROVIDER=openai
LLM_FALLBACK_ORDER=openai
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=60000
LLM_MAX_OUTPUT_TOKENS=1024
LLM_CONCURRENCY=3
LLM_PROMPT_VERSION=v2
LLM_INPUT_PRICE_PER_MTOK=0.15
LLM_OUTPUT_PRICE_PER_MTOK=0.6

INGESTION_REQUEST_TIMEOUT_MS=20000
INGESTION_MAX_RETRIES=3
INGESTION_LOCK_TTL_MS=1800000
JOB_STALE_DAYS=45

VITE_API_BASE_URL=http://localhost:5050
